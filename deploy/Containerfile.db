# Postgres with the schema and seed data baked in. The seed runs only when the
# Base images are pinned by digest so builds are reproducible: CI rebuilds from
# scratch, and an unchanged image must keep its ID or deploy.sh would re-upload it.
# Update a pin deliberately with: skopeo inspect --format '{{.Digest}}' docker://<image>
# data volume is first initialized; later deploys don't touch existing data.
FROM docker.io/library/postgres:17@sha256:748a18a54d3842d43bc156f0840d78029b8d349e0feca98c12b9c4ce3404a6b3
COPY src/sql /sql
COPY db/init/02-seed.sh /docker-entrypoint-initdb.d/02-seed.sh
