# Caddy serving the built frontend and proxying /ws to the game server.
# Base images are pinned by digest so builds are reproducible: CI rebuilds from
# scratch, and an unchanged image must keep its ID or deploy.sh would re-upload it.
# Update a pin deliberately with: skopeo inspect --format '{{.Digest}}' docker://<image>
# deploy/deploy.sh passes the frontend's dist/ as the "frontend" build context.
FROM docker.io/library/caddy:2@sha256:4fcafa98afd1c2e642e353e3c5cf9ddbe892fcee14bc990e7ba2c5b78e51f9cf
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend . /srv
