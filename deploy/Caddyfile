# MUD_DOMAIN and ACME_EMAIL come from ~/mud/caddy.env on the host (not in git).
{
	email {$ACME_EMAIL}
}

{$MUD_DOMAIN} {
	encode zstd gzip

	handle /ws {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
